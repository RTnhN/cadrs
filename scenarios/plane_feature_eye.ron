// #66: a Plane feature's row has an eye, like a sketch's: hiding the plane with it and showing
// it again; its context menu offers Show for a hidden plane.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("feature-top")),
        Key("Enter"),
        Wait(3),
        Hover(ui("feature-plane-1")),
        Wait(2),
        Screenshot("01-plane-row-eye-on-hover"),
        Click(ui("feature-plane-1-visibility")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("02-plane-hidden"),
        RightClick(ui("feature-plane-1")),
        WaitFor("feature-show"),
        Screenshot("03-menu-offers-show"),
        Click(ui("feature-show")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("04-plane-shown-again"),
    ],
)
