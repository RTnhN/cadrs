// #64: the Delete key removes the mate selected in the Mates list (mates stand-in, with Planar 1
// (Table–Puck) and Ball 1 (Socket–Ball)).
// 01 both mates listed.
// 02 Ball 1's row clicked: selected.
// 03 Delete: Ball 1 gone, Planar 1 left.
// 04 Ctrl+Z: Ball 1 back.
Scenario(
    start: Some("document"),
    steps: [
        Custom("fixture mates_standin"),
        Click(ui("insert-tab")),
        WaitFor("create-assembly"),
        Click(ui("create-assembly")),
        Click(ui("insert")),
        WaitFor("insert-dialog"),
        Click(ui("insert-search-field")),
        Key("Ctrl+A"),
        Type("Table"),
        Click(ui("insert-part-table")),
