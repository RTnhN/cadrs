// CAM Studio, 3D: the Rocket Guidance Reflector stand-in (`Custom("reflector")`: a 182 mm plate
// whose bottom is a spherical dish) machined from below on a 3-axis mill: the setup's tool axis
// points down the model's −Z, so the dish faces the spindle.
// 01 Create setup: Z along −Z, the work coordinate system at the stock's (now) top centre.
// 02 Rough (Bodies): constant-Z roughing with a D10 end mill, previewed live: levels following
//    the dish, 0.3 mm left on the walls and floors.
// 03 Parallel finishing with a D6 ball mill, previewed live: raster passes dropped exactly onto
//    the dish (the drop-cutter on the kernel's tessellation).
// 04 Verify of the setup: the dish roughed and finished, no gouges.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("reflector"),
        Wait(3),
        Click(ui("insert-tab")),
        WaitFor("create-cam-studio"),
        Click(ui("create-cam-studio")),
        WaitFor("cam-tree"),
        Click(ui("cam-tb-insert")),
        WaitFor("cam-insert-part"),
        Click(ui("cam-insert-part")),
        WaitFor("cam-dialog"),
        Click(ui("cam-dialog-accept")),
        Wait(5),
        Click(ui("cam-tb-job")),
        WaitFor("cam-dialog"),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Click(ui("cam-tb-machine")),
        WaitFor("cam-dialog"),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Click(ui("cam-tb-setup")),
        WaitFor("cam-dialog"),
        Click(ui("cam-f-p-z")),
        Click(ui("cam-f-p-z-option-1")),
        Custom("view 35 -32"),
        Custom("fit"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("01-setup-from-below"),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Click(ui("cam-tb-tool")),
        WaitFor("cam-dialog"),
        Click(ui("cam-f-lib-tool")),
        Click(ui("cam-f-lib-tool-option-2")),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Click(ui("cam-tb-toolpath")),
        WaitFor("cam-dialog"),
        Click(ui("cam-f-type")),
        Click(ui("cam-f-type-option-2")),
        MoveTo(1420, 900),
        Wait(20),
        Screenshot("02-rough"),
        Click(ui("cam-dialog-accept")),
        Wait(5),
        Click(ui("cam-tb-tool")),
        WaitFor("cam-dialog"),
        Click(ui("cam-f-lib-tool")),
        Click(ui("cam-f-lib-tool-option-3")),
        Click(ui("cam-dialog-accept")),
        Wait(3),
        Click(ui("cam-tb-toolpath")),
        WaitFor("cam-dialog"),
        Click(ui("cam-f-type")),
        Click(ui("cam-f-type-option-2")),
        Click(ui("cam-f-pattern")),
        Click(ui("cam-f-pattern-option-1")),
        MoveTo(1420, 900),
        Wait(20),
        Screenshot("03-parallel"),
        Click(ui("cam-dialog-accept")),
        Wait(5),
        Custom("cam select setup 0"),
        Click(ui("cam-tb-preview")),
        WaitFor("cam-preview-bar"),
        Click(ui("cam-pv-verify")),
        Custom("cam preview-end"),
        MoveTo(1420, 900),
        Wait(10),
        Screenshot("04-verify"),
    ],
)
