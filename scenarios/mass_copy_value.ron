// #67: clicking a value in the Mass properties panel copies it, with its unit, to the clipboard
// (a toast says what was copied).
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top rect 0 0 100 60"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(50, 30, 0)),
        Key("Enter"),
        Key("F"),
        Click(ui("view-mass")),
        WaitFor("mass-dialog"),
        Click(xyz(50, 30, 25)),
        Wait(3),
        Hover(ui("mass-volume")),
        Wait(10),
        Screenshot("01-hover-click-to-copy"),
        Click(ui("mass-volume")),
        Wait(2),
        Screenshot("02-copied-toast"),
    ],
)
