// Sketch Circular pattern (Onshape's sketch Circular pattern): select a circle, choose
// Pattern ▾ › Circular pattern; the dialog previews four instances evenly round the sketch
// origin (360°). Six instances, then Enter, make the five copies. Dragging the circle's rim
// resizes every copy. Right-click a copy → Edit circular pattern: picking a sketch point as the
// Center and 180° lays the six out on a half turn about it; dragging the point along the X axis (it
// was placed on it) swings them all about it.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("C"),
        ClickWorld(30, 0),
        ClickWorld(35, 0),
        Key("Escape"),
        Key("Escape"),
        Click(ui("sketch-point")),
        ClickWorld(10, 0),
        Key("Escape"),
        ClickWorld(30, 5),
        Click(ui("sketch-pattern-caret")),
        Wait(2),
        Screenshot("01-pattern-menu"),
        Click(ui("sketch-variant-circular-pattern")),
        WaitFor("sketch-pattern-dialog"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("02-four-round-the-origin"),
        ExpectText("sketch-pattern-center", "Sketch origin"),
        Click(ui("sketch-pattern-count-field")),
        Key("Ctrl+A"),
        Type("6"),
        Key("Enter"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-six-made"),
        Drag(world(35, 0), world(33, 0)),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-copies-follow-the-seed"),
        RightClick(world(30, 3)),
        WaitFor("sketch-pattern-menu"),
        Screenshot("05-edit-circular-pattern-menu"),
        Click(ui("sketch-pattern-edit")),
        WaitFor("sketch-pattern-dialog"),
        Click(ui("sketch-pattern-center")),
        ClickWorld(10, 0),
        Wait(2),
        ExpectText("sketch-pattern-center", "Sketch point"),
        Click(ui("sketch-pattern-angle-field")),
        Key("Ctrl+A"),
        Type("180"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-half-turn-about-the-point-previewed"),
        Key("Enter"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("07-half-turn-made"),
        // The point sits on the X axis (its × glyph), so it slides along it.
        Drag(world(10, 0), world(-5, 0)),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("08-copies-swing-with-the-center"),
    ],
)
