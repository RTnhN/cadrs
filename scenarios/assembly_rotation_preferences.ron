// Local assembly rotation increments: live-field OK, persistence, Cancel, and validation.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("account")),
        Click(ui("account-preferences")),
        WaitFor("preferences-dialog"),
        ExpectText("pref-rotation-snap", "45"),
        ExpectText("pref-rotation-snap-tolerance", "10"),
        ExpectText("pref-rotation-snap-hint", "Shift"),
        Screenshot("01-rotation-preference-and-shift-hint"),
        Click(ui("pref-rotation-snap-field")),
        Key("Ctrl+A"),
        Type("22.5"),
        Click(ui("pref-rotation-snap-tolerance-field")),
        Key("Ctrl+A"),
        Type("15"),
        Click(ui("pref-ok")),
        Click(ui("account")),
        Click(ui("account-preferences")),
        WaitFor("preferences-dialog"),
        ExpectText("pref-rotation-snap", "22.5"),
        ExpectText("pref-rotation-snap-tolerance", "15"),
        Screenshot("02-fractional-increment-saved"),
        Click(ui("pref-rotation-snap-field")),
        Key("Ctrl+A"),
        Type("90"),
        Click(ui("pref-cancel")),
        Click(ui("account")),
        Click(ui("account-preferences")),
        WaitFor("preferences-dialog"),
        ExpectText("pref-rotation-snap", "22.5"),
        Click(ui("pref-rotation-snap-field")),
        Key("Ctrl+A"),
        Type("-1"),
        Click(ui("pref-ok")),
        WaitFor("preferences-dialog"),
        ExpectText("pref-rotation-snap", "-1"),
        Screenshot("03-invalid-increment-keeps-dialog-open"),
        Click(ui("pref-rotation-snap-field")),
        Key("Ctrl+A"),
        Type("0"),
        Click(ui("pref-ok")),
        Click(ui("account")),
        Click(ui("account-preferences")),
        WaitFor("preferences-dialog"),
        ExpectText("pref-rotation-snap", "0"),
        Screenshot("04-snapping-disabled"),
        Click(ui("pref-cancel")),
    ],
)
