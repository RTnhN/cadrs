// Hide and show planes from the feature list: a Plane feature's row has the eye on hover, as a
// sketch's does (hidden, its row greys out), and Hide / Show, Show all planes and Hide all planes
// in its menu. A default plane's row has the same menu. Hide all planes hides the default planes
// and the Plane features; Show all planes brings them all back (one undo step for the features).
// 09: editing Plane 1, picking Plane 1 (its row) is ignored: a plane can't be its own input.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        // Plane 1: 25 mm above Top.
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("feature-top")),
        Click(ui("plane-dialog-accept")),
        Key("F"),
        Hover(ui("feature-plane-1")),
        Wait(3),
        Screenshot("01-hover-plane-row-shows-eye"),
        Click(ui("feature-plane-1-visibility")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("02-plane-1-hidden-row-greyed"),
        RightClick(ui("feature-plane-1")),
        Wait(2),
        Screenshot("03-plane-menu-show-and-all-planes"),
        Click(ui("feature-show")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-plane-1-shown-again"),
        RightClick(ui("feature-front")),
        Wait(2),
        Screenshot("05-default-plane-menu"),
        Click(ui("plane-hide-all")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-all-planes-hidden"),
        RightClick(ui("feature-plane-1")),
        Wait(2),
        Click(ui("feature-show-all-planes")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("07-all-planes-shown"),
        RightClick(ui("feature-right")),
        Wait(2),
        Click(ui("plane-hide")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("08-right-hidden-from-its-menu"),
        RightClick(ui("feature-plane-1")),
        Wait(2),
        Click(ui("feature-edit")),
        WaitFor("plane-dialog"),
        Click(ui("feature-plane-1")),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("09-plane-1-not-its-own-input"),
    ],
)
