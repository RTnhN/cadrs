// #112: organising the documents page as a file manager does. Eight documents and the folders
// "Brackets" and "Covers" (listed above the documents, by name).
// 01 a click on the first document, then Shift+click on the fourth: all four selected; 02
//    Ctrl+click on the second: it leaves the selection (three left).
// 03 the three dragged onto Brackets (the folder outlined, a label "3 items" at the pointer);
//    04 dropped: they move into it (a toast with Undo), the list shows the rest.
// 05 Covers dragged onto Brackets: folders nest; 06 Brackets opened: Covers and the three
//    documents, under the breadcrumb Owned by me › Brackets.
// 07 a document dragged onto the breadcrumb's "Owned by me": back at the top level.
// 08 Covers' right-click menu (Open, Rename…, Copy…, Move to ▸, Details…, Move to trash); 09
//    Rename… → "Lids".
// 10 two documents selected, right-click: the selection's menu (Copy, Move to ▸, Move to trash).
// 11 back at the top level, Brackets moved to the trash: gone with what it holds; 12 the Trash
//    lists the folder; 13 restored, with its contents.
Scenario(
    start: Some("landing"),
    seed_documents: 8,
    steps: [
        Click(ui("create")),
        WaitFor("new-folder"),
        Click(ui("new-folder")),
        WaitFor("new-folder-dialog"),
        Type("Brackets"),
        Key("Enter"),
        Click(ui("create")),
        WaitFor("new-folder"),
        Click(ui("new-folder")),
        WaitFor("new-folder-dialog"),
        Type("Covers"),
        Key("Enter"),
        WaitFor("folder-row-1"),
        // Shift: a range.
        Click(ui("doc-name-0")),
        KeyDown("Shift"),
        Click(ui("doc-name-3")),
        KeyUp("Shift"),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("01-shift-click-range"),
        // Ctrl: one in or out.
        KeyDown("Ctrl"),
        Click(ui("doc-name-1")),
        KeyUp("Ctrl"),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("02-ctrl-click-toggles"),
        // The selection dragged onto Brackets.
        Press(ui("doc-name-2")),
        Wait(2),
        Hover(ui_at("doc-row-4", 0.3, 0.5)),
        Wait(2),
        Hover(ui_at("folder-row-0", 0.3, 0.5)),
        Wait(4),
        Screenshot("03-dragging-onto-folder"),
        Release,
        Wait(6),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("04-dropped-into-folder"),
        // A folder into a folder.
        Press(ui("folder-row-1")),
        Wait(2),
        Hover(ui_at("doc-row-1", 0.3, 0.5)),
        Wait(2),
        Hover(ui_at("folder-row-0", 0.3, 0.5)),
        Wait(4),
        Release,
        Wait(6),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("05-folder-into-folder"),
        DoubleClick(ui("folder-row-0")),
        WaitFor("crumb-root"),
        Wait(3),
        Screenshot("06-inside-brackets"),
        // Out again, onto the breadcrumb's root.
        Press(ui("doc-name-0")),
        Wait(2),
        Hover(ui_at("doc-row-1", 0.3, 0.5)),
        Wait(2),
        Hover(ui("crumb-root")),
        Wait(4),
        Release,
        Wait(6),
        MoveTo(1300, 700),
        Wait(2),
        Screenshot("07-dragged-onto-breadcrumb-root"),
        // The folder's menu.
        RightClick(ui("folder-row-0")),
        WaitFor("folder-context-menu"),
        Hover(ui("folder-move")),
        Wait(3),
        Screenshot("08-folder-context-menu"),
        Key("Escape"),
        RightClick(ui("folder-row-0")),
        WaitFor("folder-rename"),
        Click(ui("folder-rename")),
        WaitFor("rename-folder-dialog"),
        Type("Lids"),
        Key("Enter"),
        Wait(3),
        Screenshot("09-folder-renamed"),
        // A selection's menu.
        Click(ui("doc-name-0")),
        KeyDown("Ctrl"),
        Click(ui("doc-name-1")),
        KeyUp("Ctrl"),
        RightClick(ui("doc-name-1")),
        WaitFor("multi-context-menu"),
        Hover(ui("multi-move")),
        Wait(3),
        Screenshot("10-selection-context-menu"),
        Key("Escape"),
        // A folder to the trash and back.
        Click(ui("crumb-root")),
        WaitFor("folder-row-0"),
        RightClick(ui("folder-row-0")),
        WaitFor("folder-trash"),
        Click(ui("folder-trash")),
        MoveTo(1300, 700),
        Wait(3),
        Screenshot("11-folder-trashed"),
        Click(ui("filter-trash")),
        WaitFor("folder-row-0"),
        Wait(2),
        Screenshot("12-trash-lists-the-folder"),
        RightClick(ui("folder-row-0")),
        WaitFor("folder-restore"),
        Click(ui("folder-restore")),
        Click(ui("filter-owned")),
        WaitFor("folder-row-0"),
        MoveTo(1300, 700),
        Wait(3),
        Screenshot("13-folder-restored"),
    ],
)
