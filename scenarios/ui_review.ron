// The new look on real work (for review, with `ui_new_look`): a part with its features; a
// feature's dialog; a sketch; an assembly with its instance list; a drawing.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("bracket"),
        Key("Shift+7"),
        Key("F"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("01-part"),
        Click(ui("feature-extrude-1")),
        Wait(3),
        Screenshot("02-feature-selected"),
        DoubleClick(ui("feature-extrude-1")),
        WaitFor("extrude-dialog"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-feature-dialog"),
        Key("Escape"),
        Wait(5),
        Custom("fixture pneumatic_cylinder_ex2"),
        Click(ui("tab-cylinder-assembly")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(5),
        Screenshot("04-assembly"),
        Custom("ujoint-drawing"),
        Key("F"),
        MoveTo(1500, 960),
        Wait(5),
        Screenshot("05-drawing"),
    ],
)
