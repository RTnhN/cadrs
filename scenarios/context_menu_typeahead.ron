// Typing in a context menu filters it and Enter chooses the highlighted item: a Plane's row
// menu, "hid" leaves Hide highlighted and Enter hides the plane; typing what matches nothing
// says so, Escape clears it and then closes the menu; a submenu's items are found too.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("plane")),
        WaitFor("plane-dialog"),
        Click(ui("feature-top")),
        Key("Enter"),
        Wait(3),
        RightClick(ui("feature-plane-1")),
        WaitFor("feature-hide"),
        Screenshot("01-menu-open"),
        Type("hid"),
        ExpectText("menu-typeahead-text", "hid"),
        Screenshot("02-typed-hid"),
        Key("Enter"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-plane-hidden"),
        RightClick(ui("feature-plane-1")),
        WaitFor("feature-show"),
        Type("zzz"),
        ExpectText("menu-typeahead", "No matches"),
        Screenshot("04-no-matches"),
        Key("Escape"),
        Wait(2),
        Screenshot("05-cleared"),
        Key("ArrowDown"),
        Wait(2),
        Screenshot("06-arrow-down"),
        Key("Escape"),
        Wait(2),
        Screenshot("07-closed"),
        // A submenu's items join the matches as "Submenu › Item".
        RightClick(ui("feature-plane-1")),
        WaitFor("feature-show"),
        Type("dyn"),
        ExpectText("menu-typeahead-text", "dyn"),
        Screenshot("08-submenu-items"),
        Key("Escape"),
        Key("Escape"),
    ],
)
