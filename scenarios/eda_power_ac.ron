// The power library's mains ports: AC_L_IN, AC_L_OUT, AC_N_IN and AC_N_OUT placed (P) on a new
// board's schematic. Points are sheet millimetres (`flat(x, y)`, Y up).
// 01 the chooser filtered to "AC_": the four ports; 02 them placed, in and out of each net.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("pcb-studio"),
        WaitFor("pcb-tree"),
        Click(ui("pcb-add-board")),
        WaitFor("pcb-name-edit"),
        Key("Enter"),
        WaitFor("eda-mode-bar"),
        MoveTo(800, 500),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("AC_"),
        Wait(2),
        Screenshot("01-chooser"),
        Key("Escape"),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("AC_L_IN"),
        Key("Enter"),
        Click(flat(101.6, 101.6)),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("AC_L_OUT"),
        Key("Enter"),
        Click(flat(114.3, 101.6)),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("AC_N_IN"),
        Key("Enter"),
        Click(flat(127.0, 101.6)),
        Key("P"),
        WaitFor("eda-chooser"),
        Click(ui("eda-chooser-filter-field")),
        Type("AC_N_OUT"),
        Key("Enter"),
        Click(flat(139.7, 101.6)),
        Key("Escape"),
        Custom("eda-zoom 95 95 146 112"),
        MoveTo(1100, 860),
        Wait(2),
        Screenshot("02-placed"),
    ],
)
