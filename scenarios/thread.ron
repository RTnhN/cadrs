// Thread (`cadrs_core::thread`): a Ø20 × 30 shaft; the toolbar's Thread with its top edge
// picked: an external thread, the size fitted to it (M20 × 2.5), 30 mm of the shaft's length
// capped at twice the diameter; a fine pitch, 15 mm, left-hand; accepted. Then a 30 × 30 × 10
// block with a Ø17.5 hole (M20's tap drill): the hole's top edge picked, an internal M20 thread
// up to its end. Then a Ø55 shaft, larger than the table's sizes: a Custom size of Ø55 with
// M48's 5 mm pitch, the pitch typed to 4 mm.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Custom("sketch top circle 0 0 10"),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(0, 0, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("30"),
        Key("Enter"),
        Key("F"),
        Click(ui("thread")),
        WaitFor("thread-dialog"),
        Click(xyz(10, 0, 30)),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("01-external-m20-fitted"),
        Click(ui("thread-pitch")),
        Click(ui("thread-pitch-option-1")),
        Click(ui("thread-length-field")),
        Key("Ctrl+A"),
        Type("15"),
        Key("Tab"),
        Click(ui("thread-hand")),
        Click(ui("thread-hand-option-1")),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("02-fine-15mm-left-hand"),
        Click(ui("thread-dialog-accept")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("03-accepted"),
        Custom("sketch top rect 30 -15 60 15 circle 45 0 8.75"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(33, 12, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("10"),
        Key("Enter"),
        Key("F"),
        Click(ui("thread")),
        WaitFor("thread-dialog"),
        Click(xyz(53.75, 0, 10)),
        Click(ui("thread-end")),
        Click(ui("thread-end-option-1")),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("04-internal-m20-up-to-end"),
        Click(ui("thread-dialog-accept")),
        Key("F"),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("05-both-threads"),
        Key("Shift+1"),
        Scroll(xyz(10, 0, 25), 10),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("06-front-close-up"),
        Key("Shift+7"),
        Custom("sketch top circle -60 0 27.5"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        Click(xyz(-60, 0, 0)),
        Click(ui("extrude-depth-field")),
        Key("Ctrl+A"),
        Type("20"),
        Key("Enter"),
        Key("F"),
        Click(ui("thread")),
        WaitFor("thread-dialog"),
        Click(xyz(-32.5, 0, 20)),
        Click(ui("thread-custom-pitch-field")),
        Key("Ctrl+A"),
        Type("4"),
        Key("Tab"),
        MoveTo(1420, 900),
        Wait(4),
        Screenshot("07-custom-m55x4"),
        Click(ui("thread-dialog-accept")),
        MoveTo(1420, 900),
        Wait(3),
        Screenshot("08-three-threads"),
    ],
)
