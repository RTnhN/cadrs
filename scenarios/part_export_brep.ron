// Experimental OpenCASCADE BREP export of two parts, with a visible compatibility warning.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        ClickAt(560, 575),
        Key("N"),
        Key("G"),
        ClickWorld(0, 0),
        ClickWorld(50, 30),
        Key("G"),
        ClickWorld(70, 0),
        ClickWorld(90, 20),
        Key("Escape"),
        Click(ui("sketch-dialog-accept")),
        Key("Shift+7"),
        Key("Shift+E"),
        WaitFor("extrude-dialog"),
        ClickWorld(25, 15),
        ClickWorld(80, 10),
        Key("Enter"),
        Click(ui("part-row-part-1")),
        Click(ui("part-row-part-2")),
        RightClick(ui("part-row-part-2")),
        Hover(ui("part-export")),
        Wait(3),
        Screenshot("01-context-menu-export"),
        Click(ui("part-export")),
        WaitFor("export-dialog"),
        Click(ui("export-format-brep")),
        Wait(3),
        ExpectText("export-brep-warning-text", "Experimental"),
        ExpectText("export-brep-warning-text", "different geometry kernel"),
        Screenshot("02-export-dialog-brep-warning"),
        Click(ui("export-ok")),
        WaitFor("export-toast"),
        Screenshot("03-exported-toast"),
    ],
)
