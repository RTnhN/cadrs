// #37: the Mirror tool takes a selection box. The sketch of `course_s19_mirror` (a vertical
// construction line, and on its left a line chain, an arc and a circle). Mirror, pick the line,
// then press on empty space and drag a box left to right around the chain, the arc and the
// circle (not the whole axis): the window box is shown while dragging, and releasing mirrors
// everything it enclosed at once, the copies linked with Σ Symmetric glyphs. One Ctrl+Z undoes
// all of them together.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("Q"),
        Key("L"),
        ClickWorld(0, -55),
        ClickWorld(0, 55),
        Key("Escape"),
        Key("Q"),
        ClickWorld(0, -30),
        ClickWorld(-40, -30),
        ClickWorld(-40, 10),
        Key("Escape"),
        Key("Escape"),
        Key("A"),
        ClickWorld(-40, 10),
        ClickWorld(-12, 38),
        ClickWorld(-33, 31),
        Key("Escape"),
        Key("Escape"),
        Key("C"),
        ClickWorld(-22, -12),
        ClickWorld(-15, -12),
        Key("Escape"),
        Key("Escape"),
        Click(ui("sketch-mirror")),
        Click(world(0, 20)),
        Press(world(-50, 45)),
        MoveWorld(-30, 20),
        Wait(2),
        MoveWorld(5, -40),
        Wait(3),
        Screenshot("01-mirror-box-dragged"),
        WaitFor("sketch-box-select"),
        Release,
        Wait(3),
        MoveTo(1400, 850),
        Wait(2),
        Screenshot("02-mirrored-at-once"),
        Key("Ctrl+Z"),
        Wait(3),
        Screenshot("03-one-undo-step"),
    ],
)
