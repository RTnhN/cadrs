// Sketch Linear pattern (Onshape's sketch Linear pattern): select a circle, choose Pattern ▾ ›
// Linear pattern; the dialog opens with the circle as its entity and previews one copy 24 mm to
// the right. Clicking the Direction field and then a slanted construction line runs the
// pattern along the line (its Angle row hides). A second direction (two rows) and four
// instances, then Enter, make the seven copies, linked to the circle. Dragging the line's far
// end turns the rows with it; dragging the circle's rim resizes every copy. Right-click a copy
// → Edit linear pattern: two instances leave one copy in each row.
Scenario(
    start: Some("document"),
    steps: [
        WaitFor("document-shell"),
        Click(ui("sketch")),
        WaitFor("sketch-dialog"),
        Click(ui("feature-top")),
        Key("N"),
        Key("C"),
        ClickWorld(-40, 0),
        ClickWorld(-32, 0),
        Key("Escape"),
        Key("Escape"),
        Key("L"),
        ClickWorld(-50, -30),
        ClickWorld(-10, -20),
        Key("Escape"),
        Key("Escape"),
        ClickWorld(-40, 8),
        Wait(2),
        Screenshot("01-circle-selected"),
        Click(ui("sketch-pattern")),
        WaitFor("sketch-pattern-dialog"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("02-dialog-one-copy-previewed"),
        ExpectText("sketch-pattern-entities", "1 entity"),
        Click(ui("sketch-pattern-direction-1")),
        ClickWorld(-30, -25),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("03-along-the-line"),
        ExpectText("sketch-pattern-direction-1", "Sketch line"),
        ExpectText("sketch-pattern-entities", "1 entity"),
        Click(ui("sketch-pattern-second-checkbox")),
        Click(ui("sketch-pattern-count-1-field")),
        Key("Ctrl+A"),
        Type("4"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("04-grid-previewed"),
        // Enter in a field commits it and accepts the dialog.
        Key("Enter"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("05-copies-made"),
        Drag(world(-10, -20), world(-20, 0)),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("06-rows-follow-the-line"),
        Drag(world(-40, 8), world(-40, 5)),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("07-copies-follow-the-seed"),
        RightClick(world(-40, 5)),
        WaitFor("sketch-pattern-menu"),
        Screenshot("08-edit-linear-pattern-menu"),
        Click(ui("sketch-pattern-edit")),
        WaitFor("sketch-pattern-dialog"),
        Click(ui("sketch-pattern-count-1-field")),
        Key("Ctrl+A"),
        Type("2"),
        Key("Enter"),
        MoveTo(1400, 850),
        Wait(3),
        Screenshot("09-edited-to-two-instances"),
    ],
)
